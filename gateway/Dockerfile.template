# Phase 2 must replace the marker with a verified linux/arm64 digest.
FROM python:3.12-slim@sha256:RESOLVE_IN_PHASE_2

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv && uv sync --frozen --no-dev --no-group telemetry
COPY gateway ./gateway
CMD ["uv", "run", "uvicorn", "gateway.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
